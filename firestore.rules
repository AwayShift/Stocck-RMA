rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Bloqueio padrão para todas as coleções não mapeadas (Princípio do Menor Privilégio)
    match /{document=**} {
      allow read, write: if false;
    }

    // --- FUNÇÕES AUXILIARES DE SEGURANÇA --- //

    // Verifica se o usuário está autenticado
    function isSignedIn() {
      return request.auth != null;
    }

    // Verifica se o usuário autenticado é o dono do próprio documento
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Verifica se o usuário é o Administrador Primário do Sistema
    function isBootstrappedAdmin() {
      return isSignedIn() && (
        request.auth.token.get('email', '') == 'alessandro.away6@gmail.com' ||
        request.auth.token.get('email', '').matches('(?i)alessandro.away6@gmail.com')
      );
    }

    // Obtém o cargo do usuário autenticado no Firestore de forma segura
    function getUserRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '')
        : '';
    }

    // Verifica se o usuário tem privilégio de Administrador (via Email Mestre, Custom Claims ou Documento de Usuário)
    function isAdmin() {
      return isSignedIn() && (
        isBootstrappedAdmin() ||
        request.auth.token.get('admin', false) == true ||
        request.auth.token.get('role', '') == 'admin' ||
        getUserRole() == 'admin'
      );
    }

    // Verifica se o usuário tem privilégio de Gerente ou Administrador
    function isManagerOrAdmin() {
      return isSignedIn() && (
        isAdmin() ||
        request.auth.token.get('role', '') == 'manager' ||
        getUserRole() == 'manager'
      );
    }

    // --- REGRAS POR COLEÇÃO --- //

    // Coleção /users: Cada usuário lê/escreve seu próprio perfil. Administradores possuem controle total.
    match /users/{userId} {
      // Usuário lê o próprio perfil; Admin pode ler e listar todos
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();

      // Criação de perfil: O próprio usuário ao se cadastrar/autenticar ou Administrador
      allow create: if isOwner(userId) || isAdmin();

      // Atualização de perfil: O próprio usuário (dados básicos) ou Administrador (gestão de cargos)
      allow update: if isOwner(userId) || isAdmin();

      // Exclusão permitida para administradores ou para o dono da conta
      allow delete: if isAdmin() || isOwner(userId);
    }

    // Coleção /products: Leitura pública para autenticados. Escrita exclusiva para Admin ou Gerentes.
    match /products/{productId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isManagerOrAdmin();
    }

    // Coleção /triage_units: Leitura para autenticados. Escrita/alteração de status para Admin ou Gerentes.
    match /triage_units/{unitId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isManagerOrAdmin();
    }

    // Coleção /cases: Leitura para autenticados. Escrita/gestão de casos para Admin ou Gerentes.
    match /cases/{caseId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isManagerOrAdmin();
    }

    // Coleção /daily_inflows: Leitura para autenticados. Escrita/gestão de fluxo de entradas para Admin ou Gerentes.
    match /daily_inflows/{inflowId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isManagerOrAdmin();
    }

    // Coleção /logs: Registros de auditoria do sistema.
    // Qualquer autenticado pode criar. Leitura e exclusão (no reset de sistema) para Admin.
    match /logs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Coleção /_system_backups: Snapshots Online em Nuvem (Plano B Independente com suporte a Chunking).
    // Permite criação de novos snapshots e fragmentos pelo sistema/usuários autenticados.
    // BLINDAGEM DE SEGURANÇA: Proíbe estritamente alteração (update) e exclusão (delete) para garantir imutabilidade contra ataques!
    match /_system_backups/{backupId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;

      // Subcoleção /chunks para fragmentos de backups grandes (> 1MB)
      match /chunks/{chunkId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update: if false;
        allow delete: if false;
      }
    }

    // Coleção /_system_config: Configurações globais do sistema e agendamento de backups.
    match /_system_config/{configId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
  }
}

