rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Bloqueio padrão para todas as coleções não mapeadas (Princípio do Menor Privilégio)
    match /{document=**} {
      allow read, write: if false;
    }

    // --- FUNÇÕES AUXILIARES DE SEGURANÇA --- //

    // Verifica se o usuário está autenticado
    function isSignedIn() {
      return request.auth != null;
    }

    // Verifica se o usuário autenticado é o dono do próprio documento
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Obtém o documento do usuário atual se existir
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Verifica se o usuário tem privilégio de Administrador (via Custom Claims ou Documento de Usuário)
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.get('admin', false) == true ||
        request.auth.token.get('role', '') == 'admin' ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          getUserData().get('role', '') == 'admin'
        )
      );
    }

    // Verifica se o usuário tem privilégio de Gerente ou Administrador
    function isManagerOrAdmin() {
      return isSignedIn() && (
        isAdmin() ||
        request.auth.token.get('role', '') == 'manager' ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          getUserData().get('role', '') == 'manager'
        )
      );
    }

    // --- REGRAS POR COLEÇÃO --- //

    // Coleção /users: Um usuário comum só lê/escreve seu próprio perfil. Apenas Admin pode ver todos.
    match /users/{userId} {
      // Usuário lê o próprio perfil; Admin pode ler/listar qualquer um
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();

      // Criação de perfil próprio não pode auto-atribuir papéis elevados
      allow create: if (
        isOwner(userId) && (
          !request.resource.data.keys().hasAny(['role', 'isAdmin']) ||
          request.resource.data.get('role', 'user') == 'user'
        )
      ) || isAdmin();

      // Atualização de perfil próprio proíbe alteração de campos de privilégio (role, isAdmin)
      allow update: if (
        isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isAdmin'])
      ) || isAdmin();

      // Exclusão restrita a administradores
      allow delete: if isAdmin();
    }

    // Coleção /products: Leitura pública para autenticados. Escrita exclusiva para Admin ou Gerentes.
    match /products/{productId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isManagerOrAdmin();
    }

    // Coleção /triage_units: Leitura para autenticados. Escrita/alteração de status para Admin ou Gerentes.
    match /triage_units/{unitId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isManagerOrAdmin();
    }

    // Coleção /cases: Leitura para autenticados. Escrita/gestão de casos para Admin ou Gerentes.
    match /cases/{caseId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isManagerOrAdmin();
    }

    // Coleção /logs: Registros de auditoria do sistema.
    // Ninguém pode apagar ou alterar. Qualquer autenticado pode criar. Apenas Admin pode ler.
    match /logs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }
  }
}
